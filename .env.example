# Copy to .env and adjust. Everything has a working default — the base demo needs NO secrets.

# ---- LLM provider: fake (default, hermetic) | ollama (local demo) | anthropic (cloud) ----
LLM_PROVIDER=fake
# For a local-model demo: LLM_PROVIDER=ollama (uses the host's Ollama at :11434).
OLLAMA_MODEL=llama3.2:3b          # qwen3.5:9b is more reliable for tool-calling
# For a cloud-quality run: LLM_PROVIDER=anthropic + a key below.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Embedder: fake (hashing, hermetic) | bge (sentence-transformers, real semantics) ----
EMBEDDER=fake

# ---- Agent / routing knobs ----
CONFIDENCE_THRESHOLD=0.70
DEDUP_SCORE_THRESHOLD=0.90
REVIEW_SLA_SECONDS=86400

# ---- Observability (compose --profile obs sets these) ----
OTEL_ENABLED=false
